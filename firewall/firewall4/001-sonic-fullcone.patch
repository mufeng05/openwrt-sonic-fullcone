--- /dev/null
+++ b/root/usr/share/firewall4/templates/zone-fullcone.uc
@@ -0,0 +1,33 @@
+{# /usr/share/firewall4/templates/zone-fullcone.uc
+   proto:  string (L4 protocol name) or null
+
+   The srcnat rule carries a port range, because the kernel side is SONiC's
+   and only enforces what fullcone needs when a range is present. SONiC's
+   natmgr never passes --fullcone without one, and get_unique_tuple() checks
+   3-tuple uniqueness only in its NF_NAT_RANGE_PROTO_SPECIFIED branch; with
+   no range, a translated port passes on a 5-tuple check alone. Two inside
+   hosts are then given the same external port, and an unsolicited packet
+   to it goes to whichever of them mapped last.
+
+   nft takes a range only after a match on a protocol that has one - a port,
+   or the icmp id and gre key - so srcnat is split: those protocols with the
+   range, everything else as before. dstnat takes none, like SONiC's DNAT
+   rule; the kernel clears the range there in any case.
+
+   The set is joined here rather than with fw4.set(): that quotes anything
+   that is not an address, and nft does not resolve a quoted protocol name.
+ -#}
+{%
+	let snat_range = "1024-65535";
+	let l4 = (name) => fw4.l4proto(family, { name });
+	let keyed = map([ "tcp", "udp", "sctp", "dccp", "udplite", "icmp", "gre" ], l4);
+	let label = `${zone.name} ${fw4.nfproto(family, true)} fullcone`;
+-%}
+{% if (direction == "srcnat" && !proto): -%}
+meta nfproto {{ fw4.nfproto(family) }} meta l4proto {{ "{ " + join(", ", keyed) + " }" }} fullcone to :{{ snat_range }} comment "!fw4: {{ label }} NAT srcnat"
+		meta nfproto {{ fw4.nfproto(family) }} fullcone comment "!fw4: {{ label }} NAT srcnat, other protocols"
+{% elif (direction == "srcnat" && (l4(proto) in keyed)): -%}
+meta nfproto {{ fw4.nfproto(family) }} meta l4proto {{ l4(proto) }} fullcone to :{{ snat_range }} comment "!fw4: {{ label }} {{ proto }} NAT srcnat"
+{% else -%}
+meta nfproto {{ fw4.nfproto(family) }}{{ proto ? ` meta l4proto ${l4(proto)}` : '' }} fullcone comment "!fw4: {{ label }}{{ proto ? ` ${proto}` : '' }} NAT {{ direction }}"
+{% endif -%}
--- a/root/usr/share/ucode/fw4.uc
+++ b/root/usr/share/ucode/fw4.uc
@@ -489,6 +489,29 @@ function nft_try_hw_offload(devices) {
 	return (rc == 0);
 }
 
+function nft_try_fullcone() {
+	/* Probe the forms zone-fullcone.uc emits. srcnat carries a port range,
+	 * and a kernel that has the expression but not its range attributes
+	 * should turn fullcone off here rather than fail the whole ruleset. */
+	let nft_test =
+		'add table inet fw4-fullcone-test; ' +
+		'add chain inet fw4-fullcone-test dstnat { ' +
+			'type nat hook prerouting priority -100; policy accept; ' +
+			'fullcone; ' +
+		'}; ' +
+		'add chain inet fw4-fullcone-test srcnat { ' +
+			'type nat hook postrouting priority -100; policy accept; ' +
+			'meta l4proto { tcp, udp } fullcone to :1024-65535; ' +
+			'fullcone; ' +
+		'}; ';
+	let cmd = sprintf("/usr/sbin/nft -c '%s' 2>/dev/null", replace(nft_test, "'", "'\\''"));
+	let ok = system(cmd) == 0;
+	if (!ok) {
+		warn("nft_try_fullcone: fullcone expression not available in kernel\n");
+	}
+	return ok;
+}
+
 
 return {
 	read_kernel_version: function() {
@@ -1472,6 +1495,7 @@ return {
 			"helper",
 			"mark",
 			"dscp",
+			"fullcone",
 			"dnat",
 			"snat",
 			"masquerade",
@@ -1946,6 +1970,7 @@ return {
 		}
 
 		let defs = this.parse_options(data, {
+			fullcone: [ "bool", "0" ],
 			input: [ "policy", "drop" ],
 			output: [ "policy", "drop" ],
 			forward: [ "policy", "drop" ],
@@ -1980,6 +2005,13 @@ return {
 
 		delete defs.syn_flood;
 
+		if (defs.fullcone) {
+			if (!nft_try_fullcone()) {
+				delete defs.fullcone;
+				warn("fullcone expression not available, disabling fullcone globally\n");
+			}
+		}
+
 		this.state.defaults = defs;
 	},
 
@@ -2005,6 +2037,9 @@ return {
 
 			masq6: [ "bool" ],
 
+			fullcone: [ "bool" ],
+			fullcone_proto: [ "protocol", null, PARSE_LIST ],
+
 			extra: [ "string", null, UNSUPPORTED ],
 			extra_src: [ "string", null, UNSUPPORTED ],
 			extra_dest: [ "string", null, UNSUPPORTED ],
@@ -2036,6 +2071,28 @@ return {
 			}
 		}
 
+		/* SONiC fullcone: defaults.fullcone is a global gate.
+		 * When off, all fullcone is disabled regardless of zone config.
+		 * When on, each zone must explicitly set fullcone=1 to enable.
+		 *
+		 * Flatten fullcone_proto (list of protocol objects) into plain
+		 * name strings suitable for direct use in nftables templates.
+		 */
+		zone.fullcone = !!(this.state.defaults.fullcone && zone.fullcone);
+		zone.fullcone6 = zone.fullcone;
+
+		if (zone.fullcone_proto && length(zone.fullcone_proto)) {
+			let names = [];
+			for (let p in zone.fullcone_proto) {
+				if (!p || p.any || !p.name)
+					continue;
+				push(names, p.name);
+			}
+			zone.fullcone_proto = length(names) ? names : null;
+		} else {
+			zone.fullcone_proto = null;
+		}
+
 		if (zone.mtu_fix && this.kernel < 0x040a0000) {
 			this.warn_section(data, "option 'mtu_fix' requires kernel 4.10 or later");
 			return;
@@ -2206,6 +2263,19 @@ return {
 		zone.related_physdevs = related_physdevs;
 
-		if (zone.masq || zone.masq6)
+		if (zone.masq) {
 			zone.dflags.snat = true;
+			if (zone.fullcone)
+				zone.dflags.dnat = true;
+		}
+
+		if (zone.masq6) {
+			zone.dflags.snat = true;
+			if (zone.fullcone6)
+				zone.dflags.dnat = true;
+		}
+
+		/* Like masq zones, fullcone zones get no automatic helpers. */
+		if (zone.fullcone || zone.fullcone6)
+			zone.auto_helper = false;
 
 		if ((zone.auto_helper && !(zone.masq || zone.masq6)) || length(zone.helper)) {
